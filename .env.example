# Supabase public client
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase server-only admin key
SUPABASE_SERVICE_ROLE_KEY=

# Stripe live or test keys. Keep all three from the same Stripe mode.
STRIPE_SECRET_KEY=
# Use one value for a single endpoint, or comma-separated values for separate
# Stripe "your account" and "connected accounts" webhook endpoints.
STRIPE_WEBHOOK_SECRET=

# Optional: set this when the production domain is not the request host.
APP_ORIGIN=
